{
  "name": "@newlogic-digital/ui",
  "version": "4.3.0",
  "type": "module",
  "main": "vite.config.js",
  "author": "New Logic Studio s.r.o.",
  "description": "Lightweight, modern and modular CSS framework with the best principles",
  "license": "GNU GPLv3",
  "scripts": {
    "postinstall": "rm -rf node_modules/typed-query-selector && newlogic-core postinstall && ncu",
    "dev": "npm run cleanup && vite",
    "dev-emails": "npm run cleanup && vite --mode emails",
    "preview": "vite preview",
    "build": "npm run cleanup && vite build --mode development",
    "build-production": "npm run cleanup && vite build",
    "build-emails": "vite build --mode emails",
    "cleanup": "git clean -qdfX public -e \\!userfiles",
    "oxlint": "oxlint",
    "oxlint-fix": "oxlint --fix",
    "stylelint": "stylelint 'src/**/*.css'",
    "stylelint-fix": "stylelint 'src/**/*.css' --fix",
    "lint": "npm run oxlint && npm run stylelint"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@hotwired/stimulus": "^3.2.2",
    "@newlogic-digital/cookieconsent-js": "^1.1.1",
    "@newlogic-digital/naja-extensions": "^1.0.3",
    "@newlogic-digital/stimulus-components": "^1.2.0",
    "@newlogic-digital/swup-plugins": "^1.0.0",
    "@newlogic-digital/utils-js": "^1.2.0",
    "naja": "^3.3.3",
    "slide-element": "^2.3.1",
    "swup": "^4.8.3",
    "winduum": "^2.2.19",
    "winduum-email": "^0.0.1",
    "winduum-stimulus": "^2.0.12"
  },
  "devDependencies": {
    "@newlogic-digital/core": "^4.0.0",
    "@tailwindcss/vite": "4.2.2",
    "vite": "^8.0.1"
  },
  "browserslist": [
    "> 1%",
    "last 2 major versions",
    "not kaios > 0",
    "not dead"
  ],
  "files": [
    "src"
  ],
  "exports": {
    "./src/*": "./src/*"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newlogic-digital/ui.git"
  }
}
