<!DOCTYPE html>
<html lang="{$lang}">
    <head>
        <meta charset="utf-8">
        <title>{$title}</title>

        <meta n:ifset="$keywords" name="keywords" content="{$keywords}">
        <meta n:ifset="$description" name="description" content="{$description}">
        <meta n:ifset="$author" name="author" content="{$author}">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1">
        <meta name="format-detection" content="telephone=no">
        <meta name="mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-title" content="{$title}">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="theme-color" content="{$themeColor}">

        <link
            n:foreach="$assets->links->main as $url"
            href="{$url->href|asset}"
            rel="{isset($url->rel) ? $url->rel}"
            as="{isset($url->as) ? $url->as}"
            type="{isset($url->type) ? $url->type}"
            crossorigin="{isset($url->crossorigin) ? '' : null}"
        >

        <script n:if="$darkMode">
            (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) && document.documentElement.classList.add('dark')
        </script>

        <script n:ifset="$assets->scripts->main" src="{$assets->scripts->main|asset}" type="module"></script>

        <link rel="icon" type="image/svg+xml" href="/favicons/favicon.svg">
        <link rel="icon" type="image/webp" href="/favicons/favicon-512.webp">
        <link rel="apple-touch-icon" type="image/webp" href="/favicons/favicon-512.webp">
        <link rel="manifest" href="/favicons/manifest.webmanifest">
    </head>
    <body data-controller="x-app invoke" data-naja-snippet-append>
        {if isset($head)}
            {include '../utils/components.latte', components => $head}
        {/if}
        <main class="x-main view-transition-main" n:ifset="$body">
            {include '../utils/components.latte', components => $body}
        </main>
        {if isset($foot)}
            {include '../utils/components.latte', components => $foot}
        {/if}

        {if $cookieConsent}
            {include '../components/cookieconsent/CookieConsentDialog.latte'}
        {/if}

        <div class="x-toaster items-end" aria-live="polite" aria-atomic="true" n:if="$showToast">
            {include '../components/(ui)/Toast.latte'}
        </div>
    </body>
</html>
